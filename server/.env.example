# 서버 포트
PORT=4000

# 프론트엔드 주소 (CORS 허용, 여러 개면 쉼표로 구분)
CLIENT_ORIGIN=http://localhost:5173

# Supabase — 프로젝트 Settings > API 에서 확인
# 비워두면 로컬 개발용 메모리 저장소(재시작 시 초기화)로 동작합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=attachments

# 자동 삭제 설정
RETENTION_DAYS=30
CLEANUP_CRON=0 3 * * *
CLEANUP_TIMEZONE=Asia/Seoul
# true 로 설정하면 30일 이상 메시지가 없는 방도 함께 삭제
CLEANUP_DELETE_INACTIVE_ROOMS=false
